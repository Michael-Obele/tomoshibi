# Tomoshibi Environment Configuration — ports 7431-7435 (avoids 3000/8000/8080)

# --- Server Settings ---
# Port the API server will listen on
SERVER_PORT=7431
# Mode: debug, release, test
SERVER_MODE=debug

# --- Application Settings ---
# LogLevel: debug, info, warn, error
APP_LOGLEVEL=info

# --- Redis Settings ---
# Connection string for Redis (Local, Docker, or Managed like Upstash)
# Use rediss:// for secure connections (TLS)
REDIS_URL=redis://localhost:7434

# --- Browser Settings (Dynamic Scraping) ---
# Only needed if Chrome/Chromium is in a non-standard location
# CHROME_BIN=/usr/bin/chromium-browser
# CHROME_PATH=/usr/lib/chromium/

# --- Search API Settings ---
# Search backend: self-hosted SearXNG (primary) → Brave (optional fallback).
# SearXNG is a free meta-search engine that aggregates Google/Bing/DDG/Brave/
# Mojeek/Wikipedia, so Cinder no longer scrapes a single fragile engine.
# Run it with `docker compose up -d searxng` — exposed on http://localhost:7435.
# REQUIRED for /v1/search unless BRAVE_SEARCH_API_KEY is set.
#
# On Fly (production) the same variable is set as a secret to the sidecar
# machine's private-network address: http://searxng.internal:8080 — see
# docs/guides/SEARXNG_FLY.md (Option A) and scripts/fly-searxng.sh.
SEARXNG_ENDPOINT=http://localhost:7435

# Brave Search API Key (Free Tier: 1 req/sec, 2000 req/month) — optional
# fallback when SearXNG is unavailable or unconfigured.
# Get at https://api.search.brave.com — 2000/mo free, 1 QPS.
# Inside Docker Compose, SEARXNG_ENDPOINT=http://searxng:8080 (Docker DNS);
# standalone, use http://localhost:7435 after `docker compose up -d searxng`.
BRAVE_SEARCH_API_KEY=YOUR_API_KEY_HERE

# Stealth fallback: when STEALTH_ENABLED=true, HybridService reuses the
# shared ChromedpScraper to scrape https://search.brave.com when both
# SearXNG and Brave API fail. No second Chrome, respects recycleAfter.
# STEALTH_ENABLED=false

# --- Security ---
# API key authentication for /v1/* endpoints. Comma-separated list.
# When set, requests must include X-API-Key header. Leave empty for open access.
# On Fly: set via `fly secrets set APP_API_KEYS=<key>`.
# APP_API_KEYS=

# Rate limit per client per minute (0 = unlimited). Requires Redis.
# On Fly: set via `fly secrets set APP_RATE_LIMIT_RPM=60`.
# APP_RATE_LIMIT_RPM=60

# Every outbound fetch refuses non-public destinations (loopback, RFC1918,
# link-local incl. 169.254.169.254, CGNAT, multicast). Set true ONLY on an
# instance that is not publicly reachable, e.g. to scrape an internal wiki.
# SSRF_ALLOW_PRIVATE=false

# --- Shutdown ---
# Seconds allowed to drain in-flight requests and background tasks on
# SIGTERM. Keep below the platform's kill grace period (Fly.io kill_timeout).
# SHUTDOWN_TIMEOUT=20