# Go / build artifacts
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test and coverage
*.test
*.out
coverage.out

# Build output directories
bin/
_build/
dist/

# Vendor directory (if vendored dependencies are used)
vendor/

# Compiled repository binary (root binary only — not skills/tomoshibi/)
/tomoshibi

# Compiled binaries built at the repo root. These were tracked historically;
# they are build outputs and must not be committed.
/api
/app
/tomoshibi-api
/tomoshibi-worker
/worker

# Same build outputs, built from the module directory. The rules above are
# root-anchored, so `go build ./cmd/api` inside packages/api/ produced a 52MB
# binary that no rule covered.
/packages/api/tomoshibi-api
/packages/api/tomoshibi-worker

# IDEs and editors
.vscode/
.idea/
*.iml
*.swp
*~

# Backup / original files (e.g. CLAUDE.original.md left by editing tools)
*.orig
*.original
*.bak
*.original.md

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Environment and secret files
.env
.env.*
!.env.example

# Certificates and keys
*.pem
*.key
*.p12
*.pfx

# Logs and temporary files
*.log
*.tmp
*.temp
logs/

# Node (if present)
node_modules/

# Misc
# Ignore dependency caches, editor caches, and other local artifacts
.cache/
.pytest_cache/

# Personal test files.
#
# Scoped deliberately: a bare `*.json` here previously matched EVERY json
# file in the repo, which silently kept generated API docs
# (internal/api/docs/swagger.json) out of version control even though the
# Docker image copies that directory. Keep new patterns this specific.
/testdata-*.json
/scratch*.json
/*.local.json

# Scratch / local ticket files (cinder-parity, etc.) — not for version control
.scratch/
.superpowers/*
.superpowers/sdd/
test_reports

# Internal design docs, guides and plans — local-only, NOT part of the public
# repo. Only the docs that public assets actually link to stay tracked:
#   docs/SEARCH_COMPARISON.md  — linked from README.md + web homepage
#   docs/guides/API_REFERENCE.md — linked from the published skills.sh skill
#   docs/guides/SEARXNG_FLY.md — referenced from packages/api/.env.example
/docs/*
!/docs/SEARCH_COMPARISON.md
!/docs/guides/
/docs/guides/*
!/docs/guides/API_REFERENCE.md
!/docs/guides/SEARXNG_FLY.md
/plan/*
/plan/
/data/
test_reports/
