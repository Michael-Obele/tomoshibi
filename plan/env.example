# Server Configuration
PORT=7431
GIN_MODE=debug # release in production
LOG_LEVEL=info

# Authentication
# Simple API Key for protecting your endpoints
API_KEY=sk_my_secret_key_12345

# Redis Configuration (Required for Async/Crawl)
#
# Option A — Standard Redis URL (supports redis:// and rediss:// TLS)
REDIS_URL=redis://localhost:7434
#   Examples:
#   Local:    redis://localhost:7434
#   Upstash:  rediss://default:password@your-instance.upstash.io:6379
#
# Option B — Upstash REST credentials (auto-derives the TLS Redis URL)
#   These are the standard env vars the Upstash Console provides.
#   Falls back to this only if REDIS_URL is not set.
# UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_token_here

# Scraper Configuration
# Max concurrent scrapes to prevent getting banned
MAX_CONCURRENCY=5
# User Agent is handled automatically by the app (rotating), 
# but you can set a fixed one here to override if needed.
# USER_AGENT=Mozilla/5.0 (compatible; CinderBot/1.0; +http://cinder.svelte-apps.me)

# Browser Management
# Restart the Chrome allocator after this many scrapes to bound memory growth.
CHROME_RECYCLE_AFTER=100

# Crawl v2 (parallel + polite crawling)
# Number of parallel crawl workers (1-10).
CRAWL_CONCURRENCY=4
# Minimum interval in seconds between requests to the same host.
CRAWL_DOMAIN_DELAY=1
# Overall crawl deadline in minutes (5-720). The crawl returns a "timeout"
# result when exceeded so a misbehaving site can't hang a worker forever.
CRAWL_TIMEOUT=30
# Per-attempt scrape deadline in seconds inside a crawl (5-300).
CRAWL_SCRAPE_TIMEOUT=30
# Retries per URL (0-5); 4xx errors are never retried.
CRAWL_MAX_RETRIES=2
# Webhook delivery timeout in seconds.
WEBHOOK_TIMEOUT=10

# Search Fallback
# Brave Search API Key — fallback when SearXNG is unavailable or unconfigured.
# Get at https://api.search.brave.com — 2000/mo free, 1 QPS.
# BRAVE_SEARCH_API_KEY=
# SearXNG endpoint — inside Docker Compose use http://searxng:8080 (Docker DNS);
# standalone use http://localhost:7435 after `docker compose up -d searxng`.
# SEARXNG_ENDPOINT=http://searxng:8080
# Stealth fallback: when STEALTH_ENABLED=true, HybridService reuses the
# shared ChromedpScraper to scrape https://search.brave.com when both
# SearXNG and Brave API fail. No second Chrome, respects recycleAfter.
# STEALTH_ENABLED=false

# Auth & Rate Limiting (Phase 4)
# Comma-separated API keys; when set, /v1/* requires the X-API-Key header.
# API_KEYS=sk_a,sk_b
# Per-client requests per minute (0 = unlimited).
RATE_LIMIT_RPM=0
