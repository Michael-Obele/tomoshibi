{
  "manifest_version": 3,
  "name": "Tomoshibi Bridge",
  "version": "0.1.0",
  "description": "Lets your local Tomoshibi read and drive pages in the browser you are already signed into. Loopback only; pairs with one code.",
  "browser_specific_settings": {
    "gecko": {
      "id": "bridge@tomoshibi.dev",
      "strict_min_version": "128.0"
    }
  },
  "permissions": ["tabs", "scripting", "storage", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["src/background.js"],
    "type": "module"
  },
  "action": {
    "default_title": "Tomoshibi Bridge",
    "default_popup": "src/popup.html"
  }
}
