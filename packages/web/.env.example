# Tomoshibi Web Frontend — Environment Configuration
# Copy to .env and fill in your values.

# --- Backend Connection (required) ---
# URL of your running Tomoshibi API instance (server-side only, never exposed to browser).
PRIVATE_TOMOSHI_BACKEND_URL=http://localhost:7431
# API key if authentication is enabled on the API (server-side only).
PRIVATE_TOMOSHI_API_KEY=

# --- Web UI Authentication ---
# Password for the web UI login page.
MASTRA_PASSWORD=
