{
  "name": "tomoshi",
  "version": "1.1.2",
  "description": "Tomoshibi (灯火 — lamp light) — self-hosted web search & scraping for AI agents. One binary, $5/mo.",
  "bin": {
    "tomoshi": "dist/stdio.js",
    "tomoshibi": "dist/stdio.js",
    "tomoshibi-mcp": "dist/stdio.js"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun run --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck",
    "build": "tsc -p tsconfig.build.json && chmod +x dist/stdio.js && chmod +x dist/index.js",
    "prepublishOnly": "npm run build",
    "patch:tmcp": "echo \"no patch needed\"",
    "postinstall": "echo \"no patch needed\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Michael-Obele/tomoshibi.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/Michael-Obele/tomoshibi#readme",
  "bugs": {
    "url": "https://github.com/Michael-Obele/tomoshibi/issues"
  },
  "keywords": [
    "tmcp",
    "mcp",
    "server",
    "tomoshibi",
    "tomoshi",
    "web-scraping",
    "crawling",
    "search"
  ],
  "dependencies": {
    "tmcp": "^1.19.4",
    "@tmcp/adapter-valibot": "^0.1.6",
    "valibot": "^1.4.2",
    "@tmcp/transport-stdio": "^0.4.3",
    "@tmcp/transport-http": "^0.8.6",
    "@tmcp/transport-sse": "^0.5.5",
    "@tmcp/auth": "^0.4.1",
    "srvx": "^0.11.22"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/node": "^24.0.15",
    "typescript": "^5.7.0"
  }
}
