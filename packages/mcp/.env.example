# Tomoshibi MCP Server — Environment Configuration
# Copy to .env and fill in your values.

# --- Tomoshibi API Connection (required) ---
# URL of your running Tomoshibi API instance.
TOMOSHI_API_URL=http://localhost:7431
# API key if authentication is enabled on the API (leave empty if not using auth).
TOMOSHI_API_KEY=

# --- Search API key forwarding ---
# Keys the backend asks for (GET /v1/env) are forwarded on every request as
# X-Tomoshi-Env and resolved per request server-side — configure search API
# keys HERE instead of also in the backend's .env.
# BRAVE_SEARCH_API_KEY=    # free $5/mo credit — api-dashboard.search.brave.com
# TOMOSHI_FORWARD_ENV=     # "" = forward all backend-requested keys (default) | "false" = off | "NAME,..." = only these

# --- MCP Server ---
# Port the MCP HTTP/SSE server listens on (default: 7433).
PORT=7433
# Server identity reported in MCP handshake.
# MCP_SERVER_NAME=tomoshi-mcp
# MCP_SERVER_VERSION=1.0.0

# --- Session Storage ---
# Redis URL for MCP session persistence (optional — defaults to in-memory).
# REDIS_URL=redis://localhost:7434
# MCP_SESSION_MANAGER=memory

# --- Rate Limiting ---
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=60

# --- OAuth 2.1 (optional) ---
# OAUTH_ENABLED=false
# OAUTH_ISSUER=
# OAUTH_AUDIENCE=
# OAUTH_SCOPES=scrape,crawl,search,monitor

# --- Logging ---
# LOG_LEVEL=info
