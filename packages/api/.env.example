# Tomoshibi API — Environment
# Local: cp .env.example .env → edit → `docker compose up` or `go run ./cmd/api`
# Fly.io: non-secrets in fly.toml [env], secrets via `fly secrets set --app tomoshibi-api KEY=value` (never commit .env)

# --- Server ---
SERVER_PORT=7431          # local 7431 | fly 8080 in fly.toml (also accepts PORT)
SERVER_MODE=debug         # local debug = Swagger at /swagger | fly release in fly.toml
# GIN_MODE=debug          # mirrors SERVER_MODE; fly sets GIN_MODE=release

# --- Logging ---
APP_LOGLEVEL=info         # debug|info|warn|error | fly LOG_LEVEL=info in fly.toml (alias)
# LOG_LEVEL=info          # alias for APP_LOGLEVEL

# --- Redis (optional — required for /v1/crawl,/v1/batch,/v1/monitor; else 503) ---
REDIS_URL=redis://localhost:7434  # local: docker compose redis | fly: `fly secrets set REDIS_URL=rediss://default:<pwd>@<host>:6379` (supports rediss://)
# REDIS_HOST=localhost     # alt to REDIS_URL — rarely needed
# REDIS_PORT=7434
# REDIS_PASSWORD=
# UPSTASH_REDIS_REST_URL=https://<instance>.upstash.io  # alt to REDIS_URL; derives rediss://...:7434 when REDIS_URL empty
# UPSTASH_REDIS_REST_TOKEN=<token>                      # fly: `fly secrets set UPSTASH_REDIS_REST_URL=... UPSTASH_REDIS_REST_TOKEN=...`

# --- Search (priority: Native engines → SearXNG → Stealth → Brave) ---
SEARXNG_ENDPOINT=http://localhost:7435  # local: `docker compose up -d searxng` | fly: `fly secrets set SEARXNG_ENDPOINT=http://searxng.internal:8080` (docs/guides/SEARXNG_FLY.md)
BRAVE_SEARCH_API_KEY=       # fallback when SearXNG down — free $5 credit/month ≈ 1,000 searches (card required at signup, api-dashboard.search.brave.com) | fly: `fly secrets set BRAVE_SEARCH_API_KEY=xxx` | optional alternative: a client can supply it PER REQUEST via the X-Tomoshi-Env header (MCP TOMOSHI_FORWARD_ENV) — no server-side key needed
SERPER_API_KEY=         # optional native engine `serper` (Google SERP API) — 2,500 free queries, no card (serper.dev); skips cleanly when unset | fly: `fly secrets set SERPER_API_KEY=xxx`
TAVILY_API_KEY=         # optional native engine `tavily` — 1,000 free credits/mo (app.tavily.com); skips cleanly when unset | fly: `fly secrets set TAVILY_API_KEY=xxx`
# STEALTH_ENABLED=false     # reuses Chromedp when both fail | fly: `fly secrets set STEALTH_ENABLED=true`

# --- Native search engine layer (in-house SearXNG replacement; plan/tomoshi-search) ---
SEARCH_NATIVE_ENABLED=true   # false = skip the in-house roster, legacy chain only
SEARCH_COMPAT_ADDR=           # e.g. :7435 → SearXNG JSON API on its own port (drop-in swap); empty = off
SEARCH_ENGINES_PATH=          # override bundled engine roster (internal/search/engines/registry.default.yaml)

# --- Webshare proxies (local plumbing/rotation; free tier = 10 datacenter IPs, 1 GB/mo) ---
# Get the key: webshare.io → Dashboard → API (no card for the free tier).
# Dummy values below — replace WEBSHARE_API_KEY with your real token (or `fly secrets set`).
WEBSHARE_API_KEY=wk-REPLACE_ME_DUMMY_KEY
# WEBSHARE_PROXY_URL=           # explicit endpoint(s), comma-separated; wins over API discovery.
#                               # Backbone rotating (new IP per request):
#                               # WEBSHARE_PROXY_URL=http://user-rotate:pass@p.webshare.io:80
SEARCH_PROXY_TIER1=             # escalation proxies, comma-separated (plan tier 1: ISP/static)
SEARCH_PROXY_TIER2=             # escalation proxies, comma-separated (plan tier 2: rotating residential)
SEARCH_PROXY_BUDGET_GB=1        # hard proxy egress cap per process (0 = unlimited) — plan R3

# --- Browser ---
# CHROME_BIN / CHROME_PATH — not needed (Dockerfile sets them; local Chrome auto-detected)

# --- Security ---
APP_API_KEYS=               # local: empty = open | fly: `fly secrets set APP_API_KEYS=$(openssl rand -hex 32)` (comma-separated; also accepts API_KEYS)
# API_KEYS=sk_a,sk_b        # alias
APP_RATE_LIMIT_RPM=0        # 0 = unlimited | fly: `fly secrets set APP_RATE_LIMIT_RPM=60` (also accepts RATE_LIMIT_RPM)
# RATE_LIMIT_RPM=60         # alias

# --- Advanced (defaults fine; uncomment to tune) ---
# APP_CHROME_RECYCLE_AFTER=100      # restart Chrome after N scrapes (default 100)
# APP_SCREENSHOT_MAX_HEIGHT=16384   # max screenshot height px (default 16384, max 32768)
# SSRF_ALLOW_PRIVATE=false          # allow private IPs — only for non-public instances
# SHUTDOWN_TIMEOUT=20               # drain on SIGTERM; keep < fly.toml kill_timeout (25s)
# DISABLE_WORKER=false              # true = API-only, no embedded Asynq worker
# CRAWL_CONCURRENCY=4 / CRAWL_DOMAIN_DELAY=1 / CRAWL_TIMEOUT=30 / CRAWL_SCRAPE_TIMEOUT=30 / CRAWL_MAX_RETRIES=2 / WEBHOOK_TIMEOUT=10

# --- Local-only search telemetry (JSONL events + GET /v1/insights) ---
# TELEMETRY_ENABLED=true        # false = no recording; /v1/insights reports {"enabled":false}
# TELEMETRY_DIR=data/telemetry  # daily search-*.jsonl + engine-*.jsonl (gitignored; bind-mounted in compose)
# TELEMETRY_RETAIN_DAYS=14      # prune files older than N days on startup (0 = keep forever)
