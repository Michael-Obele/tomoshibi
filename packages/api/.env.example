# Tomoshibi API — Environment Configuration
# Copy to .env and fill in your values.

# --- Server ---
# Port the API server listens on (default: 7431)
SERVER_PORT=7431
# Mode: debug, release, test
SERVER_MODE=debug

# --- Logging ---
# LogLevel: debug, info, warn, error
APP_LOGLEVEL=info

# --- Redis (optional — required for /v1/crawl, /v1/batch, /v1/monitor) ---
# Option 1: Direct URL (supports rediss:// for TLS)
REDIS_URL=redis://localhost:7434
# Option 2: Individual fields (alternative to REDIS_URL)
# REDIS_HOST=localhost
# REDIS_PORT=7434
# REDIS_PASSWORD=
# Option 3: Upstash REST API (auto-derives rediss:// URL)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Search Backend ---
# SearXNG (primary) — self-hosted meta-search engine, free.
# Run: docker compose up -d searxng → http://localhost:7435
SEARXNG_ENDPOINT=http://localhost:7435
# Brave Search (optional fallback) — free tier: 2000 req/mo, 1 QPS.
# Get key at https://api.search.brave.com
BRAVE_SEARCH_API_KEY=
# Stealth fallback — reuses ChromedpScraper when SearXNG + Brave both fail.
# STEALTH_ENABLED=false

# --- Browser (Dynamic Scraping) ---
# Only needed if Chrome/Chromium is in a non-standard location.
# CHROME_BIN=/usr/bin/chromium-browser
# CHROME_PATH=/usr/lib/chromium/

# --- Security ---
# API key authentication for /v1/* endpoints (comma-separated).
# When set, requests must include X-API-Key header. Leave empty for open access.
API_KEYS=
# Rate limit per client per minute (0 = unlimited).
RATE_LIMIT_RPM=0

# --- Advanced ---
# Restart Chrome allocator after N scrapes to bound memory growth (default: 100).
# APP_CHROME_RECYCLE_AFTER=100
# Cap full-page screenshot height in CSS pixels (default: 16384, max: 32768).
# Taller pages are captured top-anchored and flagged truncated in the response.
# APP_SCREENSHOT_MAX_HEIGHT=16384
